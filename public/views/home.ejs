<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../styles/home.css">
    <title>Expense Tracker</title>
</head>
<body>
    <div class="navbar">
        <img src="" alt="">
        <h1>Expense Tracker</h1>
    </div>
    <div class="body">
        <div class="statistics">
            <h2>Statistics</h2>
            <div class="info">
                <div class="credit">
                    <img src="" alt="">
                    <div>
                        <h3 class="info-title">Income</h3>
                        <h3 class="money"> 
                            <% if(locals.credit){ %>
                                <%= credit %>
                            <% } else { %>
                                0
                            <% } %>
                        Rs</h3>
                    </div>
                </div>
                <div class="debit">
                    <img src="" alt="">
                    <div>
                        <h3 class="info-title">Expense</h3>
                        <h3 class="money"> 
                            <% if(locals.debit){ %>
                                <%= debit %>
                            <% } else { %>
                                0
                            <% } %>
                        Rs</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="functionBar">
            <h3>All Expenses</h3>
            <a href="/create">Add A Expense</a>
        </div>
        <div class="transaction">
            <table>
                <tr>
                    <th>Transaction</th>
                    <th>Username</th>
                    <th>Label</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
                <% locals.expenses && expenses.forEach((expense) => { %>
                    <tr data-expense-id="<%= expense._id %>">
                        <td><%= expense.name %></td>
                        <td><%= expense.username %></td>
                        <td><%= expense.label %></td>
                        <td><%= expense.type %></td>
                        <td><%= expense.amount %> Rs</td>
                        <td>
                            <button onclick="deleteExpense( <%= JSON.stringify(expense) %> )" >Delete</button>
                        </td>
                        <td>
                            <button onclick="updateExpense( <%= JSON.stringify(expense) %> )" >Update</button>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
        <% if (locals.message) { %>
            <h1><%= message %></h1>    
        <% } %>
    </div>

    <script>

        const deleteExpense = async (expense) => {

            try {
                const response = await fetch("/", {
                    method: "DELETE",  // Use DELETE method
                    headers: {
                        "Content-Type": "application/json",  // Set the content type to JSON
                    },
                    body: JSON.stringify({
                        _id: expense._id,  // Pass the expense ID to the server
                    })
                });
           
                window.location.reload();
                
            } catch (error) {
                window.alert("An error occurred while deleting the expense.");
                console.error(error);
            }
        }

        const updateExpense = async (expense) => {

            try {

                window.location.href = "/update/"+expense._id;
                
            } catch (error) {
                window.alert("An error occurred while deleting the expense.");
                console.error(error);
            }
        }

    </script>
</body>
</html>
