<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/home.css">
    <title>Budget Buddy</title>
</head>

<body>
    <nav class="navbar">
        <div class="logo">
            <img src="/assets/logo3.png" alt="Expense Tracker Logo">
        </div>
        <h1 class="gradient-text">Budget Buddy</h1>
    </nav>

    <main>
        <section class="statistics">
            <h2>Statistics</h2>
            <div class="info-container">
                <div class="info-card income-card">
                    <img src="/assets/income.png" alt="income-card">
                    <div class="content">
                        <h4>Income</h4>
                        <span class="rs">Rs.</span>
                        <div class="money"><%= locals.credit || 0 %>
                        </div>
                    </div>
                </div>
                <div class="info-card expense-card">
                    <img src="/assets/expense.png" alt="expense-card">
                    <div class="content">
                        <h4>Expense</h4>
                        <span class="rs">Rs.</span>
                        <div class="money"><%= locals.debit || 0 %>
                        </div>
                    </div>
                </div>

                <div class="info-card saving-card">
                    <img src="/assets/saving.png" alt="saving-card">
                    <div class="content">
                        <h4>Saving</h4>
                        <span class="rs">Rs.</span>
                        <div class="money"><%= (locals.credit - locals.debit) %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="transactions">
            <div class="header">
                <h2>All Expenses</h2>
                <a class="btn add-expense" href="/create">+ Add Expense</a>
            </div>
            <table class="transactions-table">
                <thead>
                    <tr>
                        <th>Transaction</th>
                        <th>Username</th>
                        <th>Label</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th class="action-head">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% (locals.expenses || []).forEach((expense)=> { %>
                        <tr>
                            <td>
                                <%= expense.name %>
                            </td>
                            <td>
                                <%= expense.username %>
                            </td>
                            <td>
                                <%= expense.label %>
                            </td>
                            <td>
                                <%= expense.type %>
                            </td>
                            <td>Rs. <%= expense.amount %>
                            </td>
                            <td class="actions">
                                <button class="btn btn-update"
                                    onclick="updateExpense('<%= expense._id %>')">Update</button>
                                <button class="btn btn-delete"
                                onclick="deleteExpense('<%= expense._id %>')">Delete</button>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </section>
    </main>

    <script>

        const updateExpense = (expenseId) => {
            window.location.href = `/update/${expenseId}`;
            //window.location.href = `/update`;
        };

        const deleteExpense = async (expenseId) => {
            try {
                const response = await fetch(`/${expenseId}`, {
                    method: "DELETE",
                    headers: {
                        "Content-Type": "application/json",
                    }
                });

                if (response.ok) {
                    alert("Expense deleted successfully.");
                    window.location.reload();
                } else {
                    throw new Error("Failed to delete expense.");
                }
            } catch (error) {
                alert(`Error: ${error.message}`);
                console.error(error);
            }
        };

    </script>
</body>

</html>